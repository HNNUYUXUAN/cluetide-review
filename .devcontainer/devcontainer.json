{
  "name": "ClueTide Agent Release Witness",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    }
  },
  "remoteUser": "vscode",
  "forwardPorts": [8787],
  "portsAttributes": {
    "8787": {
      "label": "Agent Release Witness",
      "protocol": "http",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": ["bash", "scripts/codespaces-install.sh"],
  "postStartCommand": ["bash", "scripts/codespaces-start.sh"],
  "waitFor": "postCreateCommand"
}
